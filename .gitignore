# IDE
.idea/
.vscode/
*.iml

# backend（backend/ 内另有更细的 .gitignore）
backend/target/

# frontend
frontend/node_modules/
frontend/dist/

# 工具缓存（本机/沙箱产物，不入库）
.pnpm-store/
.corepack/
.npm-cache/

# 前端构建产物（部署一体时由 pnpm build 生成到后端 static）
backend/src/main/resources/static/

# OS
.DS_Store
Thumbs.db

# 当前工作树开发服务的日志、配置与进程记录
frontend/.dev-runtime/

# 本机开发数据库配置（示例文件保留在 scripts）
backend/application-local.properties
