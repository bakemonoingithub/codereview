    {
      "id": "repoGetPullRequest",
      "name": "读取 PR 详情",
      "description": "index 使用 PR 的 number。保留 head.sha 与 base.sha；这里只读元数据，不检查或执行合并。",
      "effect": "read",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "已授权仓库的所有者",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}$"
          },
          "repo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "已授权仓库的名称",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}$"
          },
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "description": "PR 在仓库内的 number，不是全局 id"
          }
        },
        "required": [
          "owner",
          "repo",
          "index"
        ]
      },
      "request": {
        "method": "GET",
        "path": "/repos/{owner}/{repo}/pulls/{index}",
        "pathParameters": {
          "owner": {
            "argument": "owner"
          },
          "repo": {
            "argument": "repo"
          },
          "index": {
            "argument": "index"
          }
        },
        "queryParameters": {},
        "body": null
      },
      "authorization": {
        "requiresConnectionAccess": true,
        "resourceScope": {
          "type": "repository",
          "ownerArgument": "owner",
          "repoArgument": "repo"
        }
      },
      "response": {
        "successStatusCodes": [
          200
        ],
        "mediaType": "application/json",
        "rootType": "object",
        "projection": {
