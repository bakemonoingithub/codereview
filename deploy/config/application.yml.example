# 内网试运行配置；建议值尚未经过目标内网实测。
# 首次部署由 deploy.sh 替换数据库占位符，已有 application.yml 不会被覆盖。
# 模型网关、模型名称、窗口及输出能力在管理界面配置，不由此文件初始化。
# 公开包中不填写真实凭据；部署前填写 Gitea hosts，按手册核对超时与并发。
server:
  port: 8080
spring:
  application:
    name: code-review-backend
  jackson:
    time-zone: Asia/Shanghai
    default-property-inclusion: non_null
springdoc:
  api-docs:
    path: /v3/api-docs
  swagger-ui:
    path: /swagger-ui.html
agent:
  datasource:
    url: jdbc:mysql://mysql:3306/__AGENT_DB_NAME__?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
    username: __AGENT_DB_USER__
    password: __AGENT_DB_PASSWORD__
    driver-class-name: "com.mysql.cj.jdbc.Driver"
    expected-database: __AGENT_DB_NAME__
    migration-location: "classpath:db/agent-migration"
    history-table: "agent_schema_history"
    maximum-pool-size: 10
    minimum-idle: 1
    connection-timeout-millis: 10000
  tools:
    git-executable: "git"
    mirror-timeout-seconds: 120
    search-total-seconds: 10
    search-global-concurrency: 2
    search-cache-weight-bytes: 33554432
    search-cache-minutes: 5
    limits:
      envelope-max-bytes: 32768
      material-max-bytes: 24576
      tree-default-depth: 2
      tree-max-depth: 3
      tree-default-limit: 100
      tree-max-limit: 200
      find-default-limit: 50
      find-max-limit: 100
      search-default-limit: 50
      search-max-limit: 100
      search-context-lines: 2
      search-grep-max-hits: 200
      read-default-lines: 200
      read-max-lines: 400
      diff-max-items: 20
      diff-max-hunks: 10
      grep-output-max-bytes: 2097152
  repository:
    max-file-bytes: 4194304
    file-cache-weight-bytes: 134217728
    file-cache-minutes: 30
    tree-cache-size: 256
    tree-cache-minutes: 10
    allowed-extensions: ["java", "kt", "kts", "scala", "js", "ts", "jsx", "tsx", "vue", "py", "go", "cs", "cpp", "c", "h", "rb", "php", "sql", "sh", "bat", "ps1", "r", "swift", "dart", "lua", "pl", "m", "mm", "asm", "s", "xml", "yml", "yaml", "properties", "json", "toml", "ini", "conf", "gradle", "env", "md", "txt", "html", "htm", "css", "less", "scss", "sass", "styl", "jsp", "ftl", "rst", "adoc", "csv", "log"]
  model:
    connect-timeout-seconds: 30
    probe-timeout-seconds: 15
    probe-connect-timeout-seconds: 5
    safety-reserve-min-tokens: 1024
    safety-reserve-ratio: 0.1
    transport-retries: 3
    retry-base-millis: 3000
    retry-max-millis: 30000
    retry-multiplier: 2.0
    retry-jitter-ratio: 0.2
    retry-check-millis: 1000
    connectivity-validation-timeout-seconds: 600
    tool-validation-timeout-seconds: 1200
    tool-validation-output-tokens: 1024
    max-read-timeout-seconds: 600
    output-reserve-tokens: 4096
    validation-output-tokens: 64
    task-call-limit: 200
    global-concurrency: 2
    per-task-concurrency: 1
  task:
    dispatch-queue-capacity: 64
    deadline-minutes: 120
    dispatch-concurrency: 2
    recover-on-start: true
    sweep-millis: 30000
  specialist:
    max-inheritance-depth: 6
    max-auxiliary-files: 12
    max-auxiliary-bytes: 262144
    include-direct-declarations: true
    max-units-per-file: 32
    max-block-lines: 200
    execution:
      parallel-targets: 2
  report:
    max-body-chars: 1000000
    generation-timeout-minutes: 30
    dispatch-concurrency: 1
    dispatch-queue-capacity: 100
    output-tokens: 16384
  budget:
    model-turns: 48
    network-attempts: 192
    tool-attempts: 192
    deadline-minutes: 120
    output-tokens: 16384
    model-timeout-seconds: 600
    context-stop-ratio: 0.8
    no-progress-turns: 3
    max-tools-per-turn: 4
    max-protocol-errors: 2
git:
  api-base: "https://api.github.com"
  raw-base: "https://raw.githubusercontent.com"
  http:
    connect-timeout-seconds: 10
    read-timeout-seconds: 60
  github:
    hosts: ["github.com"]
  gitea:
    hosts: ["gitea.example.internal"] # 部署前填写实际 Gitea host[:port]
    api-base: ""
    token: "${GITEA_TOKEN:}"
    work-dir: "${GITEA_MIRROR_DIR:/app/data/git-mirrors}"
    local-clone-enabled: true
    mirror-timeout-seconds: 120
    diff-max-bytes: 5242880
  cache:
    commit-detail-max-size: 200
    raw-file-max-size: 500
    expire-minutes: 30
github:
  token: "${GITHUB_TOKEN:}"
app:
  ui:
    title: "智能代码分析工具"
    api-base: "api/v2"
    request-timeout-millis: 30000
    model-validation-timeout-millis: 900000
    agent-validation-timeout-millis: 2700000
    agent-poll-millis: 2000
    report-poll-millis: 2000
    specialist-poll-millis: 3000
