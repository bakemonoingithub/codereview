# =============================================================================
#  应用运行期配置模板（容器版）
#
#  这个文件不会被自动使用。首次执行 deploy.sh 时，它会：
#       config/application.yml.example  ->  config/application.yml
#  并把 __DB_USER__ / __DB_PASSWORD__ / __DB_NAME__ / __AI_BASE_URL__ / __AI_MODEL__
#  这几处占位符替换成 .env 里的实际值。
#
#  之后 deploy.sh 不再覆盖 config/application.yml（升级不会动你们的配置）。
#
#  与开发机那份 application.yml 的关键差别：
#    - 数据库主机是 compose 服务名 mysql，不是 localhost
#    - 不含任何明文口令（口令由部署时从 .env 渲染进来）
#    - Gitea 本地镜像目录固定为容器内 /app/data/git-mirrors（对应宿主机 data/git-mirrors）
# =============================================================================

server:
  port: 8080

spring:
  application:
    name: code-review-backend
  datasource:
    url: jdbc:mysql://mysql:3306/__DB_NAME__?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
    username: __DB_USER__
    password: __DB_PASSWORD__
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      maximum-pool-size: 10
      minimum-idle: 2
      connection-timeout: 30000
  flyway:
    enabled: true
    locations: classpath:db/migration
  jackson:
    time-zone: Asia/Shanghai
    default-property-inclusion: non_null

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.slf4j.Slf4jImpl
  global-config:
    banner: false
    db-config:
      id-type: assign_id
      logic-delete-field: isDeleted
      logic-delete-value: 1
      logic-not-delete-value: 0

springdoc:
  api-docs:
    path: /v3/api-docs
  swagger-ui:
    path: /swagger-ui.html

# ── AI 网关（OpenAI 兼容）──────────────────────────────────────────────────────
# 兜底配置：系统界面里配置的模型会覆盖这里。api-key 走环境变量注入，不进镜像。
deepseek:
  base-url: __AI_BASE_URL__
  api-key: ${DEEPSEEK_API_KEY:}
  model: __AI_MODEL__
  # LLM 调用超时（毫秒）。**务必保持有限**：网关挂起时靠它把单元收敛为失败，
  # 否则记录会永远停在"执行中"并占满并发线程。
  connect-timeout-ms: 10000     # 建连超时
  read-timeout-ms: 300000       # 读超时（单次调用最长等待）

# ── 审查编排参数（均有默认值，可省略）────────────────────────────────────────
review:
  concurrency: 4            # 并行限流并发数
  chunk-max-chars: 140000   # 分块阈值（字符数）
  retry-max: 3              # 单元级最大重试次数
  retry-base-millis: 1000   # 指数退避基数（1s→2s→4s）
  task-timeout-minutes: 50  # 单条审查的任务级超时
  delete-block-minutes: 60  # 删除项目时"执行中审查"的阻塞窗口（分钟）

# ── 报告生成参数（均有默认值，可省略）───────────────────────────────────────
report:
  prompt-max-chars: 140000  # 单次报告 user prompt 上限（含模板与用户补充要求）
  record-max-chars: 20000   # 单条审查记录在聚合里的上限；超出截断

# ── Git 宿主接入 ───────────────────────────────────────────────────────────────
# GitHub REST API 兜底认证（建议通过环境变量 GITHUB_TOKEN 注入，勿硬编码）
github:
  token: ${GITHUB_TOKEN:}

git:
  api-base: https://api.github.com             # REST API 根（GitHub 用）
  raw-base: https://raw.githubusercontent.com  # 原始文件根（Contents API 兜底）
  cache:
    commit-detail-max-size: 200
    raw-file-max-size: 500
    expire-minutes: 30

  # Gitea 1.16.1 接入。API 根不用配：按各项目的仓库地址推导
  # （http://host/gitea/owner/repo -> http://host/gitea/api/v1）
  gitea:
    hosts:                        # 哪些 host[:port] 归 Gitea 客户端（白名单）
      - 192.104.224.172           # 内网 Gitea
      - localhost:3000            # 本机开发用
    api-base: ""                  # 可选覆盖（含 /api/v1）
    token: ${GITEA_TOKEN:}        # 兜底令牌；项目里填了 credential 时以项目为准
    local-clone-enabled: true     # Gitea 无 compare 接口，靠本地 bare 镜像算三点差异
    # ⚠️ 必须指向持久化的挂载卷，否则每次重建容器都要重新克隆所有仓库
    work-dir: ${GITEA_MIRROR_DIR:/app/data/git-mirrors}
    mirror-timeout-seconds: 120
    diff-max-bytes: 5242880
