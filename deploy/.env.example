# =============================================================================
#  部署参数模板
#
#  用法：首次部署直接跑 `bash scripts/deploy.sh` 即可 —— 它会自动把本文件复制成
#  .env 并生成两个随机密码，然后把下面这些参数的实际值打印出来。
#
#  如果你们希望自己指定数据库密码，请在首次运行前手工执行：
#      cp .env.example .env && vi .env      # 填好 MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD
#
#  ⚠️ 两个密码只在数据库**首次初始化**时生效。数据目录（data/mysql）一旦生成，
#     再改这里不会同步到数据库里。所以：备份时请连 .env 一起备份（backup.sh 已自动做）。
# =============================================================================

# ── 对外访问 ────────────────────────────────────────────────────────────────
# 8080 已被本机 Dify 占用，这里固定用 18080；如需改动请确保端口空闲
APP_PORT=18080
# 0.0.0.0 表示所有网卡；只对内网开放可填本机内网 IP
APP_BIND_IP=0.0.0.0
# 当前运行的镜像版本，由 deploy.sh 自动维护（回滚时会被改成 previous）
APP_TAG=latest

# ── Docker 网段 ─────────────────────────────────────────────────────────────
# 留空则用 deploy.sh 自动挑选的空闲网段
CR_SUBNET=172.31.250.0/24

# ── 数据库 ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=code_review
MYSQL_USER=codereview
MYSQL_PASSWORD=
MYSQL_IMAGE_TAG=8.0.36
MYSQL_BUFFER_POOL=1G

# ── 资源上限（这台机器上还跑着 Dify / ITSM 等系统，务必保留上限）──────────────
APP_MEM_LIMIT=4g
MYSQL_MEM_LIMIT=2g
JAVA_OPTS=-Xms1g -Xmx4g -XX:+UseG1GC -XX:-UseTransparentHugePages -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai

# ── Gitea 本地镜像目录（容器内路径，对应宿主机 data/git-mirrors）──────────────
GITEA_MIRROR_DIR=/app/data/git-mirrors

# ── 内网令牌（留空则由系统界面/数据库里的配置决定）────────────────────────────
GITEA_TOKEN=
GITHUB_TOKEN=
DEEPSEEK_API_KEY=

# ── 内网 AI 网关（OpenAI 兼容）─────────────────────────────────────────────────
# 内网部署必须改成网关的接口根地址；填错了只影响大模型调用，不影响页面与四个分析器。
# 部署后也可以在系统界面里改（存数据库，优先级高于这里）。
AI_BASE_URL=http://CHANGE-ME-内网AI网关地址
AI_MODEL=deepseek-chat
