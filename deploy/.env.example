# =============================================================================
#  部署参数模板
#
#  用法：首次部署直接跑 `bash scripts/deploy.sh` 即可 —— 它会自动把本文件复制成
#  .env 并生成数据库密码。
#
#  如果要自行指定数据库密码，请在首次运行前手工执行：
#      cp .env.example .env && vi .env      # 填好三个数据库密码字段
#
#  ⚠️ MYSQL_ROOT_PASSWORD 和 MYSQL_PASSWORD 只在兼容库首次初始化时生效。
#     AGENT_DB_PASSWORD 会在每次部署时同步到独立 Agent 账号。数据目录生成后，
#     备份时请连 .env 一起备份（backup.sh 已自动做）。
# =============================================================================

# ── 对外访问 ────────────────────────────────────────────────────────────────
# 8080 已被本机 Dify 占用，这里固定用 18080；如需改动请确保端口空闲
APP_PORT=18080
# 0.0.0.0 表示所有网卡；只对内网开放可填本机内网 IP
APP_BIND_IP=0.0.0.0
# 当前运行的镜像版本，由 deploy.sh 自动维护（回滚时会被改成 previous）
APP_TAG=latest

# ── Docker 网段 ─────────────────────────────────────────────────────────────
# 留空则用 deploy.sh 自动挑选的空闲网段
CR_SUBNET=172.31.250.0/24

# ── 数据库 ──────────────────────────────────────────────────────────────────
# code_review 保留给仍使用旧数据源的兼容服务；新路线业务数据写入下方独立新库。
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=code_review
MYSQL_USER=codereview
MYSQL_PASSWORD=
MYSQL_IMAGE_TAG=8.0.36
MYSQL_BUFFER_POOL=1G

# Agent 新路线主库。deploy.sh 会生成独立随机密码、创建数据库和受限账号。
AGENT_DB_NAME=ai_code_review_agent
AGENT_DB_USER=codereview_agent
AGENT_DB_PASSWORD=

# ── 资源上限（这台机器上还跑着 Dify / ITSM 等系统，务必保留上限）──────────────
# 应用 4g 内存上限中为非堆、线程和 Git 子进程预留空间；以下为试运行建议，需按负载验证。
# 含空格的值整体加双引号。
APP_MEM_LIMIT=4g
MYSQL_MEM_LIMIT=2g
JAVA_OPTS="-Xms1g -Xmx3g -XX:+UseG1GC -XX:-UseTransparentHugePages -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"

# ── Gitea 本地镜像目录（容器内路径，对应宿主机 data/git-mirrors）──────────────
GITEA_MIRROR_DIR=/app/data/git-mirrors

# ── 仓库兜底令牌（可留空，在项目管理中分别填写）─────────────────────────
GITEA_TOKEN=
GITHUB_TOKEN=

# 模型地址、模型名、窗口／输出能力与令牌由管理界面维护。
# LLM 超时、重试和并发见 config/application.yml，不使用旧 AI_BASE_URL／AI_MODEL。
