# =============================================================================
#  Docker 构建上下文排除清单
#  构建上下文 = 仓库根目录（code/）
# =============================================================================

# ── 安全第一：本机磁盘上的配置含明文数据库密码，绝不能进镜像 ──────────────────
# 该文件被 backend/.gitignore 忽略（从未提交），但它就在磁盘上，
# 不排除的话会被 COPY backend/ 一起带进 JAR。运行期配置走 /app/config 外挂。
backend/src/main/resources/application.yml

# ── 构建产物：镜像里自己生成，避免带上本机的残留静态文件 ────────────────────
backend/target/
backend/src/main/resources/static/
frontend/dist/

# ── 依赖与包管理器缓存 ──────────────────────────────────────────────────────
**/node_modules/
**/.pnpm-store/
**/.corepack/
**/.npm-cache/

# ── 版本库与 IDE ───────────────────────────────────────────────────────────
**/.git/
**/.gitignore
**/.gitattributes
**/.idea/
**/.vscode/
**/*.iml

# ── 杂项 ───────────────────────────────────────────────────────────────────
**/*.log
**/.DS_Store
**/Thumbs.db

# ── 部署包本体：不需要进镜像 ───────────────────────────────────────────────
deploy/
